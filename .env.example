# Local development settings for running the backend on the host (cargo run / cargo test).
APP_PORT=8000

# PostgreSQL. `cargo test` creates a temporary database per test on this server,
# so the user needs the CREATEDB privilege. Point this at the Compose `backend-db`
# service, never at a shared or production database.
DATABASE_URL=postgres://dreamday:change-me@localhost:5432/dreamday
